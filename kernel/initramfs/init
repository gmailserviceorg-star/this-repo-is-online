#!/bin/busybox sh
export PATH=/bin
/bin/busybox --install -s /bin
mount -t proc proc /proc; mount -t sysfs sys /sys; mount -t devtmpfs dev /dev
exec >/dev/console 2>&1 </dev/console
SFS=/boot/rootfs.sfs; H=; PERSIST=0; SH=0
for a in $(cat /proc/cmdline); do case $a in
 stratum.sfs=*) SFS=${a#*=};; stratum.sfs_sha256=*) H=${a#*=};; stratum.persist=1) PERSIST=1;; stratum.shell=1) SH=1;;
esac; done
rescue(){ echo "stratum-initramfs: $1 -- recovery shell"; exec sh; }
[ $SH = 1 ] && rescue "requested"
n=0
while [ $n -lt 40 ]; do
 for d in /dev/sr* /dev/sd?* /dev/vd?* /dev/nvme*n*p*; do
  [ -b "$d" ] || continue
  mount -t iso9660 -o ro "$d" /iso 2>/dev/null || mount -t ext4 -o ro "$d" /iso 2>/dev/null || continue
  [ -f "/iso$SFS" ] && break 2
  umount /iso
 done
 n=$((n+1)); sleep 1
done
[ -f "/iso$SFS" ] || rescue "boot media not found"
if [ -n "$H" ]; then
 echo "stratum: verifying system image..."
 [ "$(sha256sum "/iso$SFS" | cut -d' ' -f1)" = "$H" ] || rescue "SYSTEM IMAGE HASH MISMATCH"
else echo "stratum: WARNING no image hash given"; fi
mount -t squashfs -o loop,ro "/iso$SFS" /sfs || rescue "squashfs mount failed"
U=/ovl
if [ $PERSIST = 1 ]; then
 P=$(blkid | grep 'LABEL="STRATUMDATA"' | cut -d: -f1 | head -n1)
 [ -n "$P" ] && mount -t ext4 "$P" /data && U=/data
fi
[ $U = /ovl ] && mount -t tmpfs -o size=60%,mode=755 tmpfs /ovl
mkdir -p $U/upper $U/work
mount -t overlay overlay -o lowerdir=/sfs,upperdir=$U/upper,workdir=$U/work /newroot || rescue "overlay mount failed"
mkdir -p /newroot/mnt/iso /newroot/mnt/ovl /newroot/mnt/sfs
mount --move /iso /newroot/mnt/iso; mount --move $U /newroot/mnt/ovl; mount --move /sfs /newroot/mnt/sfs
mount --move /proc /newroot/proc; mount --move /sys /newroot/sys; mount --move /dev /newroot/dev
exec switch_root /newroot /sbin/init
